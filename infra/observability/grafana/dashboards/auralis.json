{
  "title": "Auralis fleet",
  "uid": "auralis-fleet",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Nodes up", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "expr": "sum(auralis_router_node_up)", "refId": "A" }] },
    { "id": 2, "type": "timeseries", "title": "Requests routed per second", "gridPos": { "x": 6, "y": 0, "w": 9, "h": 5 },
      "targets": [{ "expr": "rate(auralis_router_routed_total[1m])", "refId": "A" }] },
    { "id": 3, "type": "timeseries", "title": "Rejected (no healthy node)", "gridPos": { "x": 15, "y": 0, "w": 9, "h": 5 },
      "targets": [{ "expr": "rate(auralis_router_rejected_total[1m])", "refId": "A" }] },
    { "id": 4, "type": "timeseries", "title": "Served per node", "gridPos": { "x": 0, "y": 5, "w": 12, "h": 7 },
      "targets": [{ "expr": "auralis_router_node_served_total", "legendFormat": "{{node}}", "refId": "A" }] },
    { "id": 5, "type": "timeseries", "title": "Real-time factor (processing / audio)", "gridPos": { "x": 12, "y": 5, "w": 12, "h": 7 },
      "targets": [{ "expr": "rate(auralis_processing_seconds_total[5m]) / rate(auralis_audio_seconds_total[5m])", "legendFormat": "{{instance}}", "refId": "A" }] },
    { "id": 6, "type": "timeseries", "title": "Node errors per second", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "targets": [{ "expr": "rate(auralis_errors_total[1m])", "legendFormat": "{{instance}}", "refId": "A" }] }
  ]
}
