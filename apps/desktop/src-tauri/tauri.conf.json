{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auralis",
  "version": "0.1.0",
  "identifier": "com.auralis.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "visible": false,
        "width": 300,
        "height": 56,
        "title": "Auralis",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Auralis",
    "resources": {
      "../../../models/bundled/*.bin": "models/"
    },
    "shortDescription": "On-device push-to-talk dictation",
    "longDescription": "Hold a hotkey, speak, release: cleaned-up text is typed into whatever app has focus. Runs entirely on-device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}