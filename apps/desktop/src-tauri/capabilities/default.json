{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, settings and welcome windows",
  "windows": [
    "main",
    "settings",
    "welcome"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "global-shortcut:default"
  ]
}